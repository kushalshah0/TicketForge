NODE_ENV=development
PORT=3000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-password
POSTGRES_DB=auth
NOTIFICATION_DATABASE_URL=postgresql://notification_svc:dev-only-password@127.0.0.1:5433/notification
PAYMENT_DATABASE_URL=postgresql://payment_svc:dev-only-password@127.0.0.1:5433/payment
AUTH_DATABASE_URL=postgresql://auth_svc:dev-only-password@127.0.0.1:5433/auth

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
LOAD_TEST_ALLOWLIST=

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://127.0.0.1:1025
NOTIFICATION_FROM=TicketForge <tickets@ticketforge.local>

JAEGER_ENDPOINT=http://127.0.0.1:4318/v1/traces

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_HOSTNAME=localhost
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_KEY_ID=ticketforge-local-1
JWT_ISSUER=ticketforge.local
JWT_AUDIENCE=ticketforge

PAYMENT_WEBHOOK_SECRET=change-me
DEMO_MODE=false
QR_SECRET=change-me

GRAFANA_ADMIN_PASSWORD=admin
DISCORD_WEBHOOK_URL=

APP_PORT_GATEWAY=3000
APP_PORT_AUTH=3001
APP_PORT_CATALOG=3002
APP_PORT_BOOKING=3003
APP_PORT_PAYMENT=3004
APP_PORT_NOTIFICATION=3005
