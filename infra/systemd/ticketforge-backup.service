[Unit]
Description=TicketForge private PostgreSQL backups
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/ticketforge-ops/infra/scripts/backup.sh
User=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=25%
MemoryMax=128M
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ticketforge/backups
