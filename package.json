{
  "name": "ticketforge",
  "version": "0.0.1",
  "description": "TicketForge event ticketing platform",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build gateway && nest build auth && nest build catalog && nest build booking && nest build payment && nest build notification",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"*.js\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/gateway/main",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "npm run typecheck:web && vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand && node scripts/check-coverage.mjs",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "npm run build:gateway && node apps/gateway/test/app.e2e.mjs",
    "test:web:e2e": "playwright test --config web/playwright.config.mjs",
    "build:gateway": "nest build gateway",
    "infra:up": "docker compose -f infra/compose/docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.infra.yml down --remove-orphans",
    "infra:reset": "docker compose -f infra/compose/docker-compose.infra.yml down -v --remove-orphans",
    "dev:gateway": "nest start gateway --watch",
    "dev:auth": "nest start auth --watch",
    "dev:catalog": "nest start catalog --watch",
    "dev:booking": "nest start booking --watch",
    "dev:payment": "nest start payment --watch",
    "dev:notification": "nest start notification --watch",
    "dev:all": "concurrently \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:catalog\" \"npm run dev:booking\" \"npm run dev:payment\" \"npm run dev:notification\"",
    "db:migrate": "echo \"Migrations are defined per service and run via Docker or service scripts.\"",
    "db:generate:auth": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:auth": "drizzle-kit migrate --config drizzle.config.ts",
    "db:generate:catalog": "drizzle-kit generate --config drizzle.catalog.config.ts",
    "db:migrate:catalog": "drizzle-kit migrate --config drizzle.catalog.config.ts",
    "db:generate:booking": "drizzle-kit generate --config drizzle.booking.config.ts",
    "db:migrate:booking": "drizzle-kit migrate --config drizzle.booking.config.ts",
    "db:generate:payment": "drizzle-kit generate --config drizzle.payment.config.ts",
    "db:migrate:payment": "drizzle-kit migrate --config drizzle.payment.config.ts",
    "db:generate:notification": "drizzle-kit generate --config drizzle.notification.config.ts",
    "db:migrate:notification": "drizzle-kit migrate --config drizzle.notification.config.ts",
    "seed": "node scripts/seed-catalog.mjs",
    "seed:catalog": "node scripts/seed-catalog.mjs",
    "dlq:replay": "node scripts/dlq-replay.mjs",
    "audit:integrity": "node scripts/audit.mjs",
    "test:audit": "node --test scripts/audit.test.mjs",
    "test:migrations": "node --test scripts/migrate.test.mjs",
    "keys:generate": "node scripts/generate-keys.mjs",
    "prepare": "husky install"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@tanstack/react-query": "^5.104.5",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.1",
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@playwright/test": "1.64.1",
    "@rspack/core": "^2.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/rabbitmq": "^12.2.0",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.0.0",
    "jest": "^30.0.0",
    "lint-staged": "^15.1.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "webpack-node-externals": "^3.0.0"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "argon2": true
  }
}
